            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"Assert error\", function () {",
              "  pm.expect(response.error).to.eql(\"Empty request body\");",
              "})"
            ]
          }
        }
      ]
    },
